# ==================== 原始数据（大文件）====================
# 5G-NIDD原始数据集
5G-NIDD-raw/
5G-NIDD-cleaned/
5G_NIDD_TIME_SERIES/

# 处理后的数据文件（.npy和.pkl很大）
# 排除所有处理后的数据文件
data/processed/**/*.npy
data/processed/**/*.pkl
data/processed/**/*.bin
data/fdg/*.csv
data/fdg/*.pkl

# 但保留metadata和README
!data/processed/raw_packet_sequences/metadata.pkl
!data/processed/*/README.md
!data/processed/**/README.md

# ==================== 模型文件（大文件）====================
# PyTorch模型
*.pth
*.pt

# 其他模型格式
*.h5
*.hdf5
*.ckpt
*.safetensors

# 模型检查点目录
checkpoints/
baseline/models/

# 但保留最终的最佳模型（可选）
# !baseline/results/hybrid_model_fixed/best_model.pth

# ==================== 日志文件 ====================
logs/
*.log
*.log.*

# 但保留logs目录结构
!logs/.gitkeep

# ==================== 结果文件 ====================
# GNN实验结果（早期实验）
results/

# 基线结果中的大文件
baseline/results/*/predictions.npy
baseline/results/*/confusion_matrix.npy
baseline/results/*/pattern_weights.npy
baseline/results/*/*.pth
baseline/results/*/*.pt

# 但保留评估报告和配置
!baseline/results/*/evaluation_report.txt
!baseline/results/*/config.json
!baseline/results/*/per_class_metrics.csv
!baseline/results/*.png
!baseline/results/*.md

# ==================== 参考文献（PDF）====================
reference/*.pdf

# 但保留README
!reference/README.md

# ==================== 归档（旧代码）====================
archive/

